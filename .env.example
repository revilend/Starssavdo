# =============================================================
# Telegram Stars, NFT, Premium va Referal boti - ENV namunasi
# =============================================================
# Bu faylni .env ga nusxalab, qiymatlarni o'zingizniki bilan almashtiring:
#   cp .env.example .env
#
# Render'da esa bu o'zgaruvchilarni render.yaml orqali
# Dashboard -> Environment -> "sync: false" qiymatlarini qo'lda kiritasiz.
# =============================================================

# BotFather'dan olingan Telegram bot tokeni
BOT_TOKEN=

# Botni boshqaradigan admin Telegram IDlari (vergul bilan ajratilgan)
# Masalan: 123456789,987654321
ADMIN_IDS=123456789,987654321

# Supabase PostgreSQL Connection String
# Dashboard -> Connect -> Session pooler:
#   postgresql://postgres.<ref>:<parol>@aws-0-<region>.pooler.supabase.com:6543/postgres
# To'g'ridan-to'g'ri ulanish (5432):
#   postgresql://postgres.<ref>:<parol>@db.<ref>.supabase.co:5432/postgres
# `?sslmode=require` qo'shilsa ham bo'ladi — kod uni avtomatik
# asyncpg'ning `ssl="require"` argumentiga aylantiradi.
DATABASE_URL=postgresql://user:password@host:5432/postgres

# PostgreSQL SSL (TLS) rejimi:
#   auto      - Supabase yoki URL'dagi sslmode bo'yicha avtomatik (standart)
#   require   - TLS majburiy (faqat TLS qo'llaydigan server uchun)
#   disable   - SSL o'chiriladi (faqat lokal, SSL'siz Postgres uchun)
DB_SSL=auto

# Referal taklif uchun berilgan yutuq (Telegram Stars)
REFERRAL_REWARD_STARS=10

# Minimal yechib olish miqdori (Telegram Stars)
MIN_WITHDRAWAL_STARS=50

# Karta to'lovida 1 ⭐️ narxi (so'm).
# To'lov summasi = stars * SOM_PER_STAR + 1..99 so'm unikal kod (10000 -> 10037).
SOM_PER_STAR=250

# Karta to'lovlari jurnali: yopiq guruh yoki kanal ID (masalan -1001234567890).
# @CardXabarBot / @HUMOcardbot shu chatga yuborgan xabarlar o'qiladi va
# summa bo'yicha balans AVTOMATIK to'ldiriladi. 0 — avtomatik tasdiqlash o'chirilgan.
# Guruhda Telegram botlarga boshqa botlar xabarini yetkazmaydi — kanal ishlatish tavsiya etiladi.
CARD_LOG_CHAT_ID=0

# Ish rejimi:
#   webhook — Render.com / production (WEBHOOK_URL majburiy)
#   polling — lokal ishlash (tashqi https manzil kerak emas)
BOT_MODE=webhook

# Telegram webhook manzili (Render beradigan https manzil, oxirida `/` yo'q)
# Masalan: https://nftyutbot.onrender.com
WEBHOOK_URL=

# Webhook path (WEBHOOK_URL bilan birlashtiriladi)
WEBHOOK_PATH=/webhook

# Telegram secret_token: webhook so'rovlari shu maxfiy satr bilan imzolanadi.
# Faqat A-Za-z0-9_- belgilari, 1-256 ta. Masalan: openssl rand -hex 32
# Bo'sh qoldirilsa tekshiruv o'chadi (production'da to'ldirish tavsiya etiladi).
WEBHOOK_SECRET=

# Server tinglaydigan port
# Render o'zi PORT environment variable'ini qo'yadi (10000+) — qo'lda yozmang.
PORT=8080
